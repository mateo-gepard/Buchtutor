# Shared server resources; provisioned through Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Enter this only in Vercel Settings > Environment Variables.
OPENROUTER_API_KEY=
# High-entropy server secret; generated during setup. Never NEXT_PUBLIC_.
RATE_LIMIT_SECRET=
# Private operator statistics login. Random password of at least 32 characters.
# Never NEXT_PUBLIC_; rotating this password also revokes active sessions.
STATS_PASSWORD=
# Maximum new generations per anonymous device and per day.
AI_DAILY_LIMIT=50
AI_SITE_DAILY_LIMIT=500
AI_MAX_COMPLETION_TOKENS=12000
# Optional public operator details. Keep placeholders until supplied.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
